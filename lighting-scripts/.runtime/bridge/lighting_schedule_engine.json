{
  "id": "1791965775278",
  "alias": "Lighting schedule: engine",
  "description": "TypeScript trigger bridge. Clock/profile/start/lamp-on inputs request durable full work. Override commits schedule rendering directly, without a state-event echo.",
  "triggers": [
    {
      "trigger": "time_pattern",
      "minutes": "/1",
      "id": "tick"
    },
    {
      "trigger": "light.turned_on",
      "target": {
        "label_id": "house_schedule"
      },
      "id": "lamp_on"
    },
    {
      "trigger": "state",
      "entity_id": [
        "light.jonathan_bedroom_ceiling",
