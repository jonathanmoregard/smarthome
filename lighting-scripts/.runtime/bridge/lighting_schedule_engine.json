        "light.meditation_ceiling",
        "light.upper_hall_ceiling",
        "light.upper_hall_stair_lamp",
        "light.living_room_sofa_table_ceiling"
      ],
      "from": [
        "unavailable",
        "unknown"
      ],
      "to": "on",
      "id": "lamp_on",
      "note": "Power restored (wall switch back on): the lamp returns unavailable -> on at its own power-on setting, which light.turned_on does not report. Static list of house_schedule lamps; add new scheduled lamps here."
