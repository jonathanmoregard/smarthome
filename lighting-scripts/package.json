{
  "name": "smarthome-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/runtime/*.test.ts",
    "dev": "node scripts/dev.mjs",
    "parity": "python3 tests/parity/gate.py",
    "parity:inventory": "python3 tests/parity/run.py --inventory",
    "verify": "npm run check && npm test && npm run parity"
  },
  "dependencies": { "home-assistant-js-websocket": "9.7.1" },
  "devDependencies": { "@types/node": "22.19.17", "typescript": "5.9.3" }
}
