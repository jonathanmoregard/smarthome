{
  "success": true,
  "action": "get",
  "automation_id": "automation.lighting_schedule_sara_mode_switch",
  "config": {
    "id": "1791984723499",
    "alias": "Lighting schedule: Sara Mode switch",
    "description": "Makes input_boolean.ls_sara_mode_mirror usable as a slide switch. When a person flips it, records or clears the mode:sara override (who = that person, via app). Changes made by the engine (mirror sync, expiry) carry no user and are ignored, so this never loops.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "input_boolean.ls_sara_mode_mirror",
        "from": "off",
        "to": "on",
        "id": "on"
      },
      {
        "trigger": "state",
        "entity_id": "input_boolean.ls_sara_mode_mirror",
        "from": "on",
        "to": "off",
        "id": "off"
      }
    ],
    "conditions": [
      {
        "condition": "template",
        "value_template": "{{ trigger.to_state.context.user_id is not none }}",
        "note": "Only a person's flip; the engine's mirror writes have no user."
      }
    ],
    "actions": [
      {
        "variables": {
          "active": "{{ 'mode:sara' in (state_attr('sensor.ls_overrides', 'overrides') or {}) }}",
          "who": "{{ trigger.to_state.context.user_id }}"
        }
      },
      {
        "choose": [
          {
            "conditions": [
              {
                "condition": "trigger",
                "id": "on"
              },
              {
                "condition": "template",
                "value_template": "{{ not active }}"
              }
            ],
            "sequence": [
              {
                "event": "ls_override",
                "event_data": {
                  "op": "set",
                  "records": [
                    {
                      "kind": "mode",
                      "target": "sara",
                      "value": "on"
                    }
                  ],
                  "via": "app",
                  "who": "{{ who }}"
                }
              }
            ]
          },
          {
            "conditions": [
              {
                "condition": "trigger",
                "id": "off"
              },
              {
                "condition": "template",
                "value_template": "{{ active }}"
              }
            ],
            "sequence": [
              {
                "event": "ls_override",
                "event_data": {
                  "op": "clear",
                  "keys": [
                    "mode:sara"
                  ],
                  "via": "app",
                  "who": "{{ who }}"
                }
              }
            ]
          }
        ]
      }
    ],
    "mode": "queued",
    "max": 10
  },
  "config_hash": "beacc8f44475fdd4"
}
