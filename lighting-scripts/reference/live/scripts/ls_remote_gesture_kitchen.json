{
  "success": true,
  "action": "get",
  "script_id": "ls_remote_gesture_kitchen",
  "config": {
    "alias": "Lighting · Kitchen Remote Gestures",
    "description": "Single quick state owner for raw power/presets/directions. A token-guarded restart script debounces power; native timer bounds the secret chord. No waits here. Cursor reset and decoding are serialized. Logical commands launch asynchronously so actuator latency cannot drop input. Every raw power event invalidates the preset cursor. Cursor -1 means no subsequent preset has been observed; first 0/4 is right/left. Unavailable cursor remains unknown. Presets use only color_temperature_move; brightness_move_to_level is the companion and never navigates, even across power.",
    "mode": "queued",
    "max": 50,
    "fields": {
      "command": {
        "selector": {
          "text": {}
        }
      },
      "payload": {
        "default": {},
        "selector": {
          "object": {}
        }
      },
      "token": {
        "default": "",
        "selector": {
          "text": {}
        }
      }
    },
    "sequence": [
      {
        "condition": "template",
        "value_template": "{{ command in ['power','power_done','preset','cancel','left','right','up','down'] }}"
      },
      {
        "variables": {
          "step": "{{ states('input_number.ls_kitchen_remote_chord_step')|int(0) }}",
          "active": "{{ is_state('timer.ls_kitchen_remote_chord','active') }}",
          "clicks": "{{ states('input_number.ls_kitchen_remote_power_count')|int(0) }}",
          "stored_token": "{{ states('input_text.ls_kitchen_remote_power_token') if has_value('input_text.ls_kitchen_remote_power_token') else '' }}"
        }
      },
      {
        "variables": {
          "quiet_active": "{{ clicks>0 and stored_token|length>0 and as_timestamp(stored_token,0)+0.6>as_timestamp(now()) }}"
        }
      },
      {
        "choose": [
          {
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ command=='power_done' }}"
              }
            ],
            "sequence": [
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ token|length==0 or token!=stored_token or clicks<=0 }}"
                  }
                ],
                "then": [
                  {
                    "stop": "Ignore stale power completion"
                  }
                ]
              },
              {
                "action": "input_number.set_value",
                "target": {
                  "entity_id": "input_number.ls_kitchen_remote_power_count"
                },
                "data": {
                  "value": 0
                }
              },
              {
                "action": "input_text.set_value",
                "target": {
                  "entity_id": "input_text.ls_kitchen_remote_power_token"
                },
                "data": {
                  "value": ""
                }
              },
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ clicks==1 or clicks>=3 }}"
                  }
                ],
                "then": [
                  {
                    "action": "input_number.set_value",
                    "target": {
                      "entity_id": "input_number.ls_kitchen_remote_chord_step"
                    },
                    "data": {
                      "value": 0
                    }
                  },
                  {
                    "action": "timer.cancel",
                    "target": {
                      "entity_id": "timer.ls_kitchen_remote_chord"
                    }
                  },
                  {
                    "variables": {
                      "room": "{{ area_id('1c125b382f1e1d19eb9e999b6cc07466') or 'kitchen' }}"
                    }
                  },
                  {
                    "if": [
                      {
                        "condition": "template",
                        "value_template": "{{ room is string and room|length>0 }}"
                      }
                    ],
                    "then": [
                      {
                        "action": "script.turn_on",
                        "target": {
                          "entity_id": "script.ls_remote_command"
                        },
                        "data": {
                          "variables": {
                            "source": "0x385b44fffea542e1",
                            "area": "{{ room }}",
                            "command": "{{ 'toggle' if clicks==1 else 'reset' }}",
                            "dry_run": false
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "stop": "Completed quiet power burst"
              }
            ]
          },
          {
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ command=='power' }}"
              }
            ],
            "sequence": [
              {
                "action": "input_number.set_value",
                "target": {
                  "entity_id": "input_number.ls_kitchen_remote_preset"
                },
                "data": {
                  "value": -1
                },
                "alias": "Resynchronize the hardware preset cursor on raw power before any arrow can arrive"
              },
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ clicks>0 and not quiet_active }}"
                  }
                ],
                "then": [
                  {
                    "action": "input_number.set_value",
                    "target": {
                      "entity_id": "input_number.ls_kitchen_remote_power_count"
                    },
                    "data": {
                      "value": 0
                    }
                  },
                  {
                    "action": "input_text.set_value",
                    "target": {
                      "entity_id": "input_text.ls_kitchen_remote_power_token"
                    },
                    "data": {
                      "value": ""
                    }
                  },
                  {
                    "if": [
                      {
                        "condition": "template",
                        "value_template": "{{ clicks==1 or clicks>=3 }}"
                      }
                    ],
                    "then": [
                      {
                        "action": "input_number.set_value",
                        "target": {
                          "entity_id": "input_number.ls_kitchen_remote_chord_step"
                        },
                        "data": {
                          "value": 0
                        }
                      },
                      {
                        "action": "timer.cancel",
                        "target": {
                          "entity_id": "timer.ls_kitchen_remote_chord"
                        }
                      },
                      {
                        "variables": {
                          "room": "{{ area_id('1c125b382f1e1d19eb9e999b6cc07466') or 'kitchen' }}"
                        }
                      },
                      {
                        "if": [
                          {
                            "condition": "template",
                            "value_template": "{{ room is string and room|length>0 }}"
                          }
                        ],
                        "then": [
                          {
                            "action": "script.turn_on",
                            "target": {
                              "entity_id": "script.ls_remote_command"
                            },
                            "data": {
                              "variables": {
                                "source": "0x385b44fffea542e1",
                                "area": "{{ room }}",
                                "command": "{{ 'toggle' if clicks==1 else 'reset' }}",
                                "dry_run": false
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "variables": {
                  "clicks": "{{ [3,clicks+1]|min if quiet_active else 1 }}"
                }
              },
              {
                "action": "input_number.set_value",
                "target": {
                  "entity_id": "input_number.ls_kitchen_remote_power_count"
                },
                "data": {
                  "value": "{{ clicks }}"
                }
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ clicks==1 }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "input_number.set_value",
                        "target": {
                          "entity_id": "input_number.ls_kitchen_remote_chord_step"
                        },
                        "data": {
                          "value": -1
                        }
                      },
                      {
                        "action": "timer.start",
                        "target": {
                          "entity_id": "timer.ls_kitchen_remote_chord"
                        },
                        "data": {
                          "duration": "00:00:03"
                        }
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ clicks==2 }}"
                      }
                    ],
                    "sequence": [
                      {
                        "if": [
                          {
                            "condition": "template",
                            "value_template": "{{ active and step==-1 }}"
                          }
                        ],
                        "then": [
                          {
                            "action": "input_number.set_value",
                            "target": {
                              "entity_id": "input_number.ls_kitchen_remote_chord_step"
                            },
                            "data": {
                              "value": 1
                            }
                          },
                          {
                            "action": "timer.start",
                            "target": {
                              "entity_id": "timer.ls_kitchen_remote_chord"
                            },
                            "data": {
                              "duration": "00:00:03"
                            }
                          }
                        ],
                        "else": [
                          {
                            "action": "input_number.set_value",
                            "target": {
                              "entity_id": "input_number.ls_kitchen_remote_chord_step"
                            },
                            "data": {
                              "value": 0
                            }
                          },
                          {
                            "action": "timer.cancel",
                            "target": {
                              "entity_id": "timer.ls_kitchen_remote_chord"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "default": [
                  {
                    "action": "input_number.set_value",
                    "target": {
                      "entity_id": "input_number.ls_kitchen_remote_chord_step"
                    },
                    "data": {
                      "value": 0
                    }
                  },
                  {
                    "action": "timer.cancel",
                    "target": {
                      "entity_id": "timer.ls_kitchen_remote_chord"
                    }
                  }
                ]
              },
              {
                "variables": {
                  "fresh_token": "{{ now().isoformat() }}"
                }
              },
              {
                "action": "input_text.set_value",
                "target": {
                  "entity_id": "input_text.ls_kitchen_remote_power_token"
                },
                "data": {
                  "value": "{{ fresh_token }}"
                }
              },
              {
                "action": "script.turn_on",
                "target": {
                  "entity_id": "script.ls_remote_power_quiet_kitchen"
                },
                "data": {
                  "variables": {
                    "token": "{{ fresh_token }}"
                  }
                }
              },
              {
                "stop": "Raw power recorded without waiting"
              }
            ]
          }
        ]
      },
      {
        "if": [
          {
            "condition": "template",
            "value_template": "{{ command=='preset' }}"
          }
        ],
        "then": [
          {
            "if": [
              {
                "condition": "template",
                "value_template": "{{ payload is not mapping or payload.get('action') != 'color_temperature_move' }}"
              }
            ],
            "then": [
              {
                "stop": "Ignore non-canonical preset companion or unrelated MQTT payload"
              }
            ]
          },
          {
            "variables": {
              "presets": [
                200,
                285,
                370,
                454,
                588
              ],
              "preset": "{{ payload.get('action_color_temperature') }}",
              "previous": "{{ states('input_number.ls_kitchen_remote_preset')|float(-2) }}"
            }
          },
          {
            "if": [
              {
                "condition": "template",
                "value_template": "{{ preset is not number or preset is boolean or preset not in presets }}"
              }
            ],
            "then": [
              {
                "action": "input_number.set_value",
                "target": {
                  "entity_id": "input_number.ls_kitchen_remote_chord_step"
                },
                "data": {
                  "value": 0
                }
              },
              {
                "action": "timer.cancel",
                "target": {
                  "entity_id": "timer.ls_kitchen_remote_chord"
                }
              },
              {
                "stop": "Unknown preset cancels chord"
              }
            ]
          },
          {
            "variables": {
              "index": "{{ presets.index(preset) }}"
            }
          },
          {
            "if": [
              {
                "condition": "template",
                "value_template": "{{ index==previous }}"
              }
            ],
            "then": [
              {
                "stop": "Ignore duplicate preset companion"
              }
            ]
          },
          {
            "variables": {
              "delta": "{{ (1 if index==0 else 4 if index==4 else -1) if previous==-1 else (index-previous|int)%5 if previous in [0,1,2,3,4] else -1 }}"
            }
          },
          {
            "action": "input_number.set_value",
            "target": {
              "entity_id": "input_number.ls_kitchen_remote_preset"
            },
            "data": {
              "value": "{{ index }}"
            }
          },
          {
            "variables": {
              "command": "{{ 'right' if delta==1 else 'left' if delta==4 else 'cancel' }}"
            }
          }
        ]
      },
      {
        "choose": [
          {
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ active and step in [1,2,3,4] and command==['left','right','left','right'][step-1] }}"
              }
            ],
            "sequence": [
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ step==4 }}"
                  }
                ],
                "then": [
                  {
                    "action": "input_number.set_value",
                    "target": {
                      "entity_id": "input_number.ls_kitchen_remote_chord_step"
                    },
                    "data": {
                      "value": 0
                    }
                  },
                  {
                    "action": "timer.cancel",
                    "target": {
                      "entity_id": "timer.ls_kitchen_remote_chord"
                    }
                  },
                  {
                    "variables": {
                      "room": "{{ area_id('1c125b382f1e1d19eb9e999b6cc07466') or 'kitchen' }}"
                    }
                  },
                  {
                    "if": [
                      {
                        "condition": "template",
                        "value_template": "{{ room is string and room|length>0 }}"
                      }
                    ],
                    "then": [
                      {
                        "action": "script.turn_on",
                        "target": {
                          "entity_id": "script.ls_remote_command"
                        },
                        "data": {
                          "variables": {
                            "source": "0x385b44fffea542e1",
                            "area": "{{ room }}",
                            "command": "sara_toggle",
                            "dry_run": false
                          }
                        }
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "action": "input_number.set_value",
                    "target": {
                      "entity_id": "input_number.ls_kitchen_remote_chord_step"
                    },
                    "data": {
                      "value": "{{ step+1 }}"
                    }
                  },
                  {
                    "action": "timer.start",
                    "target": {
                      "entity_id": "timer.ls_kitchen_remote_chord"
                    },
                    "data": {
                      "duration": "00:00:03"
                    }
                  }
                ]
              },
              {
                "stop": "Matched chord input consumed"
              }
            ]
          }
        ]
      },
      {
        "if": [
          {
            "condition": "template",
            "value_template": "{{ step!=0 or active }}"
          }
        ],
        "then": [
          {
            "action": "input_number.set_value",
            "target": {
              "entity_id": "input_number.ls_kitchen_remote_chord_step"
            },
            "data": {
              "value": 0
            }
          },
          {
            "action": "timer.cancel",
            "target": {
              "entity_id": "timer.ls_kitchen_remote_chord"
            }
          }
        ]
      },
      {
        "condition": "template",
        "value_template": "{{ command in ['left','right','up','down'] }}"
      },
      {
        "variables": {
          "room": "{{ area_id('1c125b382f1e1d19eb9e999b6cc07466') or 'kitchen' }}"
        }
      },
      {
        "if": [
          {
            "condition": "template",
            "value_template": "{{ room is string and room|length>0 }}"
          }
        ],
        "then": [
          {
            "action": "script.turn_on",
            "target": {
              "entity_id": "script.ls_remote_command"
            },
            "data": {
              "variables": {
                "source": "0x385b44fffea542e1",
                "area": "{{ room }}",
                "command": "{{ command }}",
                "dry_run": false
              }
            }
          }
        ]
      }
    ]
  },
  "config_hash": "db5850ecb0da44d3"
}
