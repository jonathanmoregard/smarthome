      {
        "trigger": "event",
        "event_type": "ls_lamp_store_changed",
        "id": "config"
      },
      {
        "trigger": "homeassistant",
        "event": "start",
        "id": "start"
      },
      {
        "trigger": "state",
        "entity_id": "sensor.ls_overrides",
        "attribute": "overrides",
        "id": "config"
      }
    ],
    "actions": [
      {
        "choose": [
          {
            "conditions": [
              {
                "condition": "trigger",
                "id": "lamp_on"
              }
            ],
            "sequence": [
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ area_id(trigger.entity_id) == 'kitchen' }}"
                  }
                ],
                "then": [
                  {
                    "delay": {
                      "seconds": 1
                    }
                  },
                  {
                    "action": "script.ls_apply",
                    "data": {
                      "reason": "lamp_on",
                      "lights": "{{ area_entities('kitchen') | select('match', 'light\\\\.') | select('is_state', 'on') | list }}"
                    }
                  }
                ],
                "else": [
                  {
                    "action": "script.ls_apply",
                    "data": {
                      "reason": "lamp_on",
                      "lights": "{{ [trigger.entity_id] }}"
                    }
                  }
                ]
              }
            ]
          },
          {
            "conditions": [
              {
                "condition": "trigger",
                "id": "tick"
              }
            ],
            "sequence": [
              {
                "action": "script.ls_apply",
                "data": {
                  "reason": "tick"
                }
              }
            ]
          }
        ],
        "default": [
          {
            "action": "script.ls_apply",
            "data": {
              "reason": "{{ trigger.id }}"
            }
          }
        ]
      }
    ],
    "mode": "parallel",
    "max": 25
