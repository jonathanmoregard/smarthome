  "action": "get",
  "automation_id": "automation.lighting_schedule_engine",
  "config": {
    "id": "1791965775278",
    "alias": "Lighting schedule: engine",
    "description": "Runs script.ls_apply: every minute (only fading lamps or lamps that just reached a block get commands), when a scheduled lamp switches on (it jumps straight to its current target; kitchen waits 1 s so its fixtures go out as one group command), when any lighting-schedule setting or the override store sensor.ls_overrides changes (applied instantly), and on HA start. Overrides are set by script.ls_override_block and the lamp change detector, and ended by the 'end overrides' rules. Per-lamp settings (input_text.ls_lamp_*) apply instantly through the ls_lamp_store_changed event that script.ls_store fires. A lamp returning from unavailable straight to on (wall power restored) also counts as switching on.",
    "triggers": [
      {
        "trigger": "time_pattern",
        "minutes": "/1",
        "id": "tick"
      },
      {
        "trigger": "light.turned_on",
        "target": {
          "label_id": "house_schedule"
        },
        "id": "lamp_on"
      },
      {
        "trigger": "state",
        "entity_id": [
          "light.jonathan_bedroom_ceiling",
          "light.jonathan_bedroom_floor_lamp",
          "light.kitchen_pendant",
          "light.kitchen_spots_1",
          "light.kitchen_spots_2",
          "light.living_room_desk_ceiling",
          "light.living_room_hall_ceiling",
          "light.living_room_table_lamp",
          "light.living_room_vicky_desk_lamp",
          "light.living_room_window_lamp",
          "light.living_room_yellow_retro_lamp",
          "light.meditation_floor_lamp",
