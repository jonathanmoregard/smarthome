{
  "alias": "Lighting \u00b7 Living Room Remote Power Quiet",
  "description": "Restartable exact subsecond debounce. Carries its token back asynchronously; actor ignores superseded completions.",
  "mode": "restart",
  "fields": {
    "token": {
      "selector": {
        "text": {}
      }
    }
  },
  "sequence": [
    {
      "delay": {
        "milliseconds": 400
      }
    },
    {
      "action": "script.turn_on",
      "target": {
        "entity_id": "script.ls_remote_gesture_living_room"
      },
      "data": {
        "variables": {
          "command": "power_done",
          "token": "{{ token }}"
        }
      }
    }
  ]
}
