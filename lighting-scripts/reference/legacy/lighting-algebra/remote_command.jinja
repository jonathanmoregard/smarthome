{% set key='channels:'~source %}{% set old=overrides.get(key,{}) %}{% set value=old.get('value',{}) %}
{% set group=current.plan.resolved.targets.get('room:'~room,{}) %}
{% set anchors=current.plan.base.get('room:'~room,{}) %}
{% set n=namespace(result={'op':'noop'}) %}
{% if room and (group or command in ['toggle','reset','sara_toggle']) and command in ['up','down','left','right','toggle','reset','sara_toggle'] %}
 {% if command=='sara_toggle' %}
  {% set n.result={'op':'clear','keys':['mode:sara'],'via':'remote'} if 'mode:sara' in overrides else {'op':'set','records':[{'kind':'mode','target':'sara','value':'on'}],'via':'remote'} %}
 {% elif command=='toggle' %}
  {% set ids=namespace(v=[]) %}
  {% for L in catalog.members if area_id(L)==room %}{% set ids.v=ids.v+[L] %}{% endfor %}
  {% for L in (state_attr('sensor.ls_overrides','switch_ranges') or {}) if area_id(L)==room %}{% set ids.v=ids.v+[L] %}{% endfor %}
  {% set saved=(state_attr('sensor.ls_overrides','power') or {}).get(room) %}
  {% set on=not saved if saved is boolean else not (ids.v|select('is_state','on')|list|count>0) %}
  {% set n.result={'op':'power','area':room,'on':on,'targets':ids.v,'via':'remote'} %}
 {% elif command=='reset' %}{% set n.result={'op':'clear_room','area':room,'via':'remote'} %}
 {% else %}
  {% set delta=anchors.day.brightness-anchors.cosy.brightness %}
  {% set floor=[76.5,anchors.cosy.brightness]|min %}
  {% set slope=[0,delta,(anchors.cosy.brightness-floor)/2]|max %}
  {% if group.level>anchors.day.brightness and anchors.day.brightness<255 %}
   {% set seed=1+(group.level-anchors.day.brightness)/(255-anchors.day.brightness) %}
  {% elif group.level<anchors.cosy.brightness and slope>0 %}
   {% set seed=[-2,(group.level-anchors.cosy.brightness)/slope]|max %}
  {% else %}{% set seed=(group.level-anchors.cosy.brightness)/delta if delta>0 else 1 %}{% endif %}
  {% set position=value.get('position',seed) if group.owners.get('brightness')==key else seed %}
  {% set patch=namespace(v={},channels={}) %}
  {% if command in ['up','down'] %}
   {% set position=[-2,[2,position+(0.1 if command=='up' else -0.1)]|min]|max %}
   {% set claim={'kind':'scale','position':position,'updated':stamp} %}
   {% set brightness={'kind':'constant','value':group.level,'updated':stamp} if command=='down' and group.level<floor else claim %}
   {% set patch.v={'position':position,'channels':{'brightness':brightness,'color':claim}} %}
   {% set S=current.plan.get('schedule_details',{}).get(room,{}) %}
   {% set patch.v=dict(patch.v,remote_valid_until=S.get('next_fs',0),remote_timing_revision=timing_revision|default(0)) %}
  {% else %}
   {% set choices=['day','cosy','Candle'] + (catalog.effects.keys()|reject('eq','Candle')|list) %}
   {% set selected=value.get('selection',group.period) %}
   {% set index=choices.index(selected) if selected in choices else 0 %}
   {% set selected=choices[(index+(1 if command=='right' else -1)) % (choices|count)] %}
   {% if selected in ['day','cosy'] %}
    {% set position=1 if selected=='day' else 0 %}{% set claim={'kind':'scale','position':position,'updated':stamp} %}
    {% set patch.v={'selection':selected,'position':position,'period':selected,'period_updated':stamp,'channels':{'brightness':claim,'color':claim}} %}
   {% else %}
    {% for channel in catalog.effects[selected].channels %}{% set patch.channels=dict(patch.channels,**{channel:{'kind':'effect','effect':selected,'instance':source~':'~selected,'updated':stamp}}) %}{% endfor %}
    {% set patch.v={'selection':selected,'channels':patch.channels} %}
   {% endif %}
  {% endif %}
  {% if patch.v %}{% set n.result={'op':'set','records':[{'kind':'channels','key':key,'source':source,'scope':'room','target':room,'value':patch.v}],'via':'remote'} %}{% endif %}
 {% endif %}
{% endif %}
{{ n.result }}
