ates. #}\n   {% if old.get('kind')=='channels' and value.get('position') is number %}\n    {% set a.v=dict(a.v,legacy_position=value.position) %}\n   {% endif %}\n  {% endif %}\n  {% for other,r in overrides.items() if other!=key and r is mapping %}\n   {% set applies=(r.get('scope')=='room' and r.get('target')==room) or (r.get('scope')=='house' and r.get('target')=='house' and room not in label_areas('private_room')) %}\n   {% set v=r.get('value',{}) %}\n   {% if applies and v is mapping %}\n    {% set claim=v.get('channels',{}).get('brightness',{}) %}\n    {% set newer=claim.get('updated',as_timestamp(r.get('when'),0)) if claim else v.get('adjustment',{}).get('updated',0) if v.get('adjustment') is mapping else 0 %}\n    {% if newer>a.v.get('updated',0) %}{% set a.restart=true %}{% endif %}\n   {% endif %}\n  {% endfor %}\n  {% if a.restart %}{% set a.v=identity %}{% endif %}\n  {# Input records are replaced as a whole; never merge old interpreted channel claims. #}\n  {% set n.value=dict(value.items()|rejectattr(0,'in',['channels','position'])|list) %}\n  {# Retain the original effect claim/instance and its carried baseline while\n     migrating a pre-input record. Its timestamps must never become this click. #}\n  {% if old.get('kind')=='channels' and value.get('channels',{}).values()|selectattr('kind','eq','effect')|list|count>0 %}\n   {% set n.value=dict(n.value,legacy_channels=value.channels) %}\n  {% endif %}\n  {% if command in ['up','down'] %}\n   {% set d=1 if command=='up' else -1 %}\n   {% set lo=[-20,[20,a.v.lower+d]|min]|max %}{% set hi=[-20,[20,a.v.upper+d]|min]|max %}\n   {% set a.v=dict(a.v,steps=(0 if lo==hi else a.v.steps+d),lower=lo,upper=hi,updated=stamp,last=command,has_up=a.v.get('has_up',false) or command=='up') %}\n   {% set n.value=dict(n.value,adjustment=a.v) %}\n  {% else %}\n   {% set n.value=dict(n.value.items()|rejectattr(0,'eq','legacy_channels')|list) %}\n   {% set choices=['day','cosy','Candle'] + (catalog.effects.keys()|reject('in',['Candle','Colour loop','Breathe','Normal light'])|list) %}\n   {% set group=current.plan.resolved.targets.get('room:'~room,{}) %}\n   {% set selected=value.get('selection',group.get('period','day')) %}\n   {% set index=choices.index(selected) if selected in choices else 0 %}\n   {% set selected=choices[(index+(1 if command=='right' else -1)) % (choices|count)] %}\n   {% set n.value=dict(n.value,selection=selected,selection_updated=stamp) %}\n   {% if selected in ['day','cosy'] %}\n    {% set n.value=dict(n.value,period=selected,period_updated=stamp,adjustment=dict(identity,anchor=selected),selection_input=none) %}\n   {% else %}\n    {% set n.value=dict(n.value,selection_input=a.v,selection_instance=source~':'~selected,adjustment=none) %}\n   {% endif %}\n  {% endif %}\n  {% set S=current.plan.get('schedule_details',{}).get(room,{}) %}\n  {% if S %}{% set n.value=dict(n.value,remote_valid_until=S.get('next_fs',0),remote_timing_revision=timing_revision) %}{% endif %}\n  {% set n.result={'op':'set','records':[{'kind':'input','key':key,'source':source,'scope':'room','target':room,'value':n.value}],'via':'remote'} %}\n {% endif %}\n{% endif %}\n{{ n.result }}\n"
