{
  "alias": "Lighting \u00b7 Pure Remote Input",
  "mode": "parallel",
  "sequence": [
    {
      "variables": {
        "overrides": "{{ state_attr('sensor.ls_overrides','overrides') or {} }}",
        "stamp": "{{ as_timestamp(now()) }}",
        "room": "{{ area if area_entities(area) else '' }}",
        "catalog": {},
        "current": {
          "plan": {
            "base": {},
            "resolved": {
              "targets": {}
            }
          }
        },
        "input_revision": "{{ states.sensor.ls_overrides.last_updated.isoformat() }}",
        "input_key": "{# One logical input stream per room; each source keeps a bounded snapshot.\n   The most recent snapshot includes preceding inputs from the room's other\n   remotes, so alternating devices cannot drop or apply a click twice. #}\n{% macro latest_remote_key(records,room) -%}\n {% set pick=namespace(key='',stamp=-1) %}\n {% for key,r in records|dictsort if r is mapping and r.get('scope')=='room' and r.get('target')==room and (r.get('kind')=='input' or (r.get('kind')=='channels' and r.get('via')=='remote')) %}\n  {% set stamp=as_timestamp(r.get('when'),0) %}\n  {% if stamp>=pick.stamp %}{% set pick.key=key %}{% set pick.stamp=stamp %}{% endif %}\n {% endfor %}\n {{- pick.key|to_json -}}\n{%- endmacro %}\n\n{{ latest_remote_key(overrides,room)|from_json }}",
        "input_record": "{{ overrides.get(input_key,{}) }}"
      }
    },
    {
      "variables": {
        "timing_revision": "{# No clock/schedule expansion: only versions of the room's expiry dependencies. #}\n{% if command in ['up','down'] and is_state('input_boolean.ls_ovr_next_block_on','on') %}\n {% set n=namespace(ids=['input_boolean.ls_ovr_next_block_on']) %}\n {% for scope in ['house',room] %}\n  {% for block in ['day','cosy','night'] %}\n   {% set n.ids=n.ids+['input_boolean.ls_'~scope~'_'~block~'_own_timing','input_datetime.ls_'~scope~'_'~block~'_start','input_datetime.ls_'~scope~'_'~block~'_weekend','input_number.ls_'~scope~'_'~block~'_fade'] %}\n  {% endfor %}\n {% endfor %}\n {% set version=namespace(latest=0) %}\n {% for entity in n.ids if states[entity] is not none %}\n  {% set version.latest=[version.latest,as_timestamp(states[entity].last_updated,0)]|max %}\n {% endfor %}\n {{ version.latest }}\n{% else %}{{ 0 }}{% endif %}\n",
        "request_id": "{{ source~':'~stamp }}"
      }
    },
    {
      "variables": {
        "needs_context": "\n{% set value=input_record.get('value',{}) %}\n{{ command in ['left','right'] or (command in ['up','down'] and is_state('input_boolean.ls_ovr_next_block_on','on') and (value.get('remote_valid_until',0)<=stamp or value.get('remote_timing_revision')!=timing_revision)) }}\n"
      }
    },
    {
      "if": [
        {
          "condition": "template",
          "value_template": "{{ needs_context }}"
        }
      ],
      "then": [
        {
          "action": "script.ls_room_plan",
          "data": {
            "room": "{{ room }}",
            "overrides": "{{ overrides }}",
            "cache": "{{ state_attr('sensor.ls_cache_'~room,'cache') or {} }}",
            "reason": "remote"
          },
          "response_variable": "current"
        }
      ]
    },
    {
      "if": [
        {
          "condition": "template",
          "value_template": "{{ command in ['toggle','left','right'] }}"
        }
      ],
      "then": [
        {
          "variables": {
            "catalog": {
