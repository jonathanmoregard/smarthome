{
  "alias": "Lighting \u00b7 Pure Remote Input",
  "mode": "parallel",
  "sequence": [
    {
      "variables": {
        "overrides": "{{ state_attr('sensor.ls_overrides','overrides') or {} }}",
        "stamp": "{{ as_timestamp(now()) }}",
        "room": "{{ area if area_entities(area) else '' }}",
        "catalog": {},
        "current": {
          "plan": {
            "base": {},
            "resolved": {
              "targets": {}
            }
          }
        },
        "input_revision": "{{ states.sensor.ls_overrides.last_updated.isoformat() }}"
      }
    },
    {
      "variables": {
        "timing_revision": "{# No clock/schedule expansion: only versions of the room's expiry dependencies. #}\n{% if command in ['up','down'] and is_state('input_boolean.ls_ovr_next_block_on','on') %}\n {% set n=namespace(ids=['input_boolean.ls_ovr_next_block_on']) %}\n {% for scope in ['house',room] %}\n  {% for block in ['day','cosy','night'] %}\n   {% set n.ids=n.ids+['input_boolean.ls_'~scope~'_'~block~'_own_timing','input_datetime.ls_'~scope~'_'~block~'_start','input_datetime.ls_'~scope~'_'~block~'_weekend','input_number.ls_'~scope~'_'~block~'_fade'] %}\n  {% endfor %}\n {% endfor %}\n {% set version=namespace(latest=0) %}\n {% for entity in n.ids if states[entity] is not none %}\n  {% set version.latest=[version.latest,as_timestamp(states[entity].last_updated,0)]|max %}\n {% endfor %}\n {{ version.latest }}\n{% else %}{{ 0 }}{% endif %}\n",
        "request_id": "{{ source~':'~stamp }}"
      }
    },
    {
      "variables": {
        "result": "{# A scale owner already has its coordinate. Advance it without rendering any lights. #}\n{% set key='channels:'~source %}{% set record=overrides.get(key,{}) %}\n{% set value=record.get('value',{}) %}\n{% set brightness=value.get('channels',{}).get('brightness',{}) if value is mapping else {} %}\n{% set n=namespace(ok=command in ['up','down'] and record.get('scope')=='room' and record.get('target')==room and brightness.get('kind')=='scale' and brightness.get('position') is number,result=none) %}\n{% if n.ok and is_state('input_boolean.ls_ovr_next_block_on','on') %}\n {% set n.ok=value.get('remote_valid_until',0)>stamp and value.get('remote_timing_revision')==timing_revision %}\n{% endif %}\n{% if n.ok %}\n {% set own_stamp=brightness.get('updated',as_timestamp(record.get('when'),0)) %}\n {% for other,r in overrides.items() if other!=key and r is mapping %}\n  {% set applies=(r.get('scope')=='room' and r.get('target')==room) or (r.get('scope')=='house' and r.get('target')=='house' and room not in label_areas('private_room')) %}\n  {% set v=r.get('value',{}) %}\n  {% if applies and v is mapping and v.get('channels') is mapping and 'brightness' in v.channels %}\n   {% set candidate=v.channels.brightness %}\n   {% set updated=candidate.get('updated',as_timestamp(r.get('when'),0)) if candidate is mapping else as_timestamp(r.get('when'),0) %}\n   {# Conservative fallback for a newer claim, even if the resolver later rejects it. #}\n   {% if updated is not number or updated>=own_stamp %}{% set n.ok=false %}{% endif %}\n  {% endif %}\n {% endfor %}\n{% endif %}\n{% if n.ok %}\n {% set position=[-2,[2,brightness.position+(0.1 if command=='up' else -0.1)]|min]|max %}\n {% set claim={'kind':'scale','position':position,'updated':stamp} %}\n {% set n.result={'op':'set','records':[{'kind':'channels','key':key,'source':source,'scope':'room','target':room,'value':{'position':position,'channels':{'brightness':claim,'color':claim}}}],'via':'remote'} %}\n{% endif %}\n{{ n.result }}\n"
      }
    },
    {
      "if": [
        {
          "condition": "template",
          "value_template": "{{ result is not mapping }}"
        }
      ],
      "then": [
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ command not in ['toggle','reset','sara_toggle'] }}"
            }
          ],
          "then": [
            {
              "action": "script.ls_room_plan",
              "data": {
                "room": "{{ room }}",
                "overrides": "{{ overrides }}",
                "cache": "{{ state_attr('sensor.ls_cache_'~room,'cache') or {} }}",
                "reason": "remote"
              },
              "response_variable": "current"
            }
          ]
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ command in ['toggle','left','right'] }}"
            }
          ],
          "then": [
            {
              "variables": {
                "catalog": {
