{
  "id": "1791982416967",
  "alias": "Lighting schedule: override store writer",
  "description": "Event adapter. All mutation/CAS checks and render scheduling belong to the synchronous queued ls_commit script.",
  "triggers": [
    {
      "trigger": "event",
      "event_type": "ls_override"
    }
  ],
  "actions": [
    {
      "action": "script.ls_commit",
      "data": {
        "data": "{{ dict(trigger.event.data,who=trigger.event.data.get(\"who\") or trigger.event.context.user_id) }}"
      }
    }
  ],
  "mode": "queued",
  "max": 50
}
