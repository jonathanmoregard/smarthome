{
  "alias": "Lighting \u00b7 Pure Room Plan",
  "mode": "parallel",
  "max": 50,
  "fields": {
    "room": {
      "selector": {
        "object": {}
      },
      "required": true
    },
    "overrides": {
      "selector": {
        "object": {}
      },
      "default": {}
    },
    "cache": {
      "selector": {
        "object": {}
      },
      "default": {}
    },
    "reason": {
      "selector": {
        "object": {}
      },
      "default": "remote"
    },
    "test_now": {
      "selector": {
        "object": {}
      }
    },
    "power": {
      "selector": {
        "object": {}
      }
    },
    "ranges": {
      "selector": {
        "object": {}
      }
    },
    "defaults": {
      "selector": {
        "object": {}
      }
    }
  },
  "sequence": [
    {
      "variables": {
        "cache_version": "db7981f72ee868e8d33ff1481dffb34e5e26570e8bf949a3cb2c505d7c3f37e1:input-processors-v1",
        "at": "{{ as_timestamp(test_now) if test_now|default(none) else as_timestamp(now()) }}",
        "revision": "{{ states.sensor.ls_overrides.last_updated.isoformat() }}",
        "plan_order": "{{ as_timestamp(now()) }}",
        "warm_end": "{{ (state_attr('light.candle_test_rgb_warm_end','rgb_color') or [255,126,0])|list }}",
        "cache": "{# Persisted internal cache may be absent, old or partially populated. #}\n{% set n=namespace(ok=cache is mapping) %}\n{% if n.ok %}\n {% for key in ['dependencies','periods','baseline','gradients','catalog'] %}{% if cache.get(key) is not mapping %}{% set n.ok=false %}{% endif %}{% endfor %}\n {% for key in ['valid_from','valid_until'] %}{% if cache.get(key) is not number or cache.get(key) is boolean %}{% set n.ok=false %}{% endif %}{% endfor %}\n{% endif %}\n{% if n.ok %}\n {% set n.ok=cache.baseline.get('targets') is mapping and cache.baseline.get('schedule') is mapping %}\n{% endif %}\n{% if n.ok %}\n {% set n.ok=cache.baseline.schedule.get('schedule_details') is mapping and cache.baseline.schedule.get('profiles') is mapping %}\n{% endif %}\n{% if n.ok %}\n {% set n.ok=cache.baseline.schedule.schedule_details.get(room) is mapping and ('room:'~room) in cache.baseline.targets %}\n{% endif %}\n{{ (cache if n.ok else {})|to_json|from_json }}\n"
      }
    },
    {
      "variables": {
        "dependencies": "{% set n=namespace(lamps=[],switches=[],values=[]) %}\n{% for L in (label_entities('house_schedule')+(label_devices('house_schedule')|map('device_entities')|sum(start=[])))|unique|sort if L.startswith('light.') and area_id(L)==room %}{% set n.lamps=n.lamps+[L] %}{% endfor %}\n{% for L in (label_entities('on_off')+(label_devices('on_off')|map('device_entities')|sum(start=[]))+(state_attr('sensor.ls_overrides','switch_ranges') or {}).keys()|list)|unique|sort if area_id(L)==room %}{% set n.switches=n.switches+[L] %}{% endfor %}\n{% for scope in ['house',room] %}\n {% for block in ['day','cosy','night'] %}\n  {% for suffix in ['start','weekend'] %}{% set n.values=n.values+[states('input_datetime.ls_'~scope~'_'~block~'_'~suffix)] %}{% endfor %}\n  {% set n.values=n.values+[states('input_number.ls_'~scope~'_'~block~'_fade'),states('input_boolean.ls_'~scope~'_'~block~'_own_timing'),states('input_boolean.ls_'~scope~'_'~block~'_own_light')] %}\n {% endfor %}\n{% endfor %}\n{% for scope in ['house',room]+(n.lamps|map('replace','light.','lamp_')|list) %}\n {% for block in ['day','cosy','night'] %}\n  {% set e='light.ls_'~scope~'_'~block %}\n  {% set n.values=n.values+[states('input_text.ls_'~scope~'_'~block),states(e),state_attr(e,'brightness'),state_attr(e,'color_mode'),state_attr(e,'color_temp_kelvin'),(state_attr(e,'rgb_color') or [])|list] %}\n {% endfor %}\n{% endfor %}\n{{ {'lamps':n.lamps,'switches':n.switches,'values':n.values,'wake':[states('input_datetime.ls_'~room~'_wake'),state_attr('input_datetime.ls_'~room~'_wake','timestamp'),states('input_number.ls_'~room~'_wake_fade')],'expiry':states('input_boolean.ls_ovr_next_block_on'),'private':room in label_areas('private_room'),'warm':warm_end|list,'tick':reason=='tick'}|to_json|from_json }}\n"
      }
    },
    {
      "variables": {
        "period_boundary": "{{ cache.get('baseline',{}).get('schedule',{}).get('schedule_details',{}).get(room,{}).get('last_fs',0) }}"
      }
    },
    {
      "variables": {
        "periods": "{% set n=namespace(records={}) %}\n{% for key,r in overrides|dictsort if r is mapping %}\n {% set applies=(r.get('kind')=='block' and r.get('target')==room) or (r.get('kind') in ['channels','input'] and ((r.get('scope')=='room' and r.get('target')==room) or (r.get('scope')=='lamp' and r.get('target') in dependencies.lamps) or (r.get('scope')=='house' and not dependencies.private))) %}\n {% set value=r.get('value') %}{% set period=value if r.get('kind')=='block' else value.get('period') if value is mapping else none %}\n {% if applies and period in ['day','cosy','night'] %}\n  {% set stamp=value.get('period_updated',as_timestamp(r.get('when'),0)) if value is mapping else as_timestamp(r.get('when'),0) %}\n  {% set n.records=dict(n.records,**{key:[r.get('kind'),r.get('scope'),r.get('target'),period,stamp,dependencies.expiry=='on' and as_timestamp(r.get('when'),0)<=period_boundary]}) %}\n {% endif %}\n{% endfor %}\n{{ n.records }}\n"
      }
    },
    {
      "variables": {
        "cache_hit": "{{ cache.get('version')==cache_version and cache.get('room')==room and cache.get('dependencies')==dependencies and cache.get('periods')==periods and cache.get('valid_from',1e20)<=at<cache.get('valid_until',0) and cache.get('baseline') is mapping and cache.get('gradients') is mapping and cache.get('catalog') is mapping }}"
      }
    },
    {
      "if": [
        {
          "condition": "template",
          "value_template": "{{ cache_hit }}"
        }
      ],
      "then": [
        {
          "variables": {
            "baseline": "{{ cache.baseline }}",
            "gradients": "{{ cache.gradients }}",
            "catalog": "{{ cache.catalog }}",
            "cache_update": null
          }
        }
      ],
