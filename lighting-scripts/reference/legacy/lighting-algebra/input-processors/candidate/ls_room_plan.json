ntity='input_select.ls_'~room~'_override' %}\n{% set mirrors=[{'entity':entity,'option':effective|capitalize}] if states[entity] is not none and states(entity)!=effective|capitalize else [] %}\n{% set details=namespace(v={room:S}) %}\n{% if cache_hit %}\n {% set details.v={room:dict(S,left=cache.valid_from+S.left-at,edge=(at-S.cur_ts)<90)} %}\n{% endif %}\n{% set profiles=namespace(v={}) %}\n{% for L,p in baseline.schedule.profiles.items() %}{% set profiles.v=dict(profiles.v,**{L:dict(p,ignore_overrides=n.targets[L].ignore_overrides)}) %}{% endfor %}\n{{ {'targets':n.targets,'schedule':dict(baseline.schedule,profiles=profiles.v,sched={room:S.get('cur')},schedule_details=details.v,stale_keys=n.stale,mirror=mirrors)}|to_json|from_json }}\n"
